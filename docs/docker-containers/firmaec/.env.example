COMPOSE_PROJECT_NAME=uta-electronic-signature
FIRMAEC_IMAGE=uta/firmaec-wildfly:5.1.0-wf40.0.1
POSTGRES_IMAGE=postgres:17.10-bookworm
FIRMAEC_PUBLIC_PORT=8180
WILDFLY_MANAGEMENT_PORT=9990
WILDFLY_MANAGEMENT_USER=uta-console-admin
FIRMAEC_DATA_DIR=/var/lib/uta-containers/firmaec-postgresql
FIRMAEC_BACKUP_DIR=/var/backups/uta-containers/firmaec-postgresql
POSTGRES_DB=firmadigital
POSTGRES_USER=firmadigital
FIRMAEC_SYSTEM_CODE=UTA-SIGNATURE
FIRMAEC_CALLBACK_URL=https://portal.uta.edu.ec/signature-api/api/v1/signature/callbacks/firmaec
# Sello visual (QR) al firmar: apagado por defecto (firma invisible, ya validada).
# Coordenadas de ejemplo tomadas de una integracion FirmaEC ya en produccion (quipux).
FIRMAEC_STAMP_ENABLED=false
FIRMAEC_STAMP_TYPE=QR
# Llx/Lly: posicion por defecto SOLO si el usuario no elige una en el visor interactivo
# del frontend (SignaturePositionPicker). Width/Height: tamaño fijo del sello, igual para
# todos los firmantes sin importar donde clickeen.
FIRMAEC_STAMP_LLX=222
FIRMAEC_STAMP_LLY=85
# urx/ury en este WildFly NO son coordenadas relativas a llx/lly: el motor de
# estampado los usa como tamaño absoluto del sello en puntos (confirmado con la
# matriz de transformacion real del QR resultante). No sumarlos a llx/lly.
FIRMAEC_STAMP_WIDTH=100
FIRMAEC_STAMP_HEIGHT=100
SIGNATURE_API_IMAGE=uta/electronic-signature-api:1.0.0
SIGNATURE_API_PORT=5060
REPOSITORY_UTA_BASE_URL=https://serviciospruebas.uta.edu.ec/WsSeguUta
HR_BACKEND_BASE_URL=https://serviciospruebas.uta.edu.ec/WsUtaSystem
SIGNATURE_PHYSICAL_PATH=\\nas11.uta.edu.ec\ArchUTA1\HR\electronic_signatures\
# Base publica del frontend (verificado: https://portal.uta.edu.ec/WsUtaSystem/login
# responde 200), usada para construir el link de firma externa de un solo uso.
FRONTEND_PUBLIC_BASE_URL=https://portal.uta.edu.ec/WsUtaSystem
